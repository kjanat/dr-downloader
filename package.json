{
	"name": "davinci-resolve-downloader",
	"version": "1.0.6",
	"description": "Download the free edition of DaVinci Resolve from Blackmagic Design",
	"keywords": [
		"davinci resolve",
		"download",
		"dreamcli",
		"ansispeck"
	],
	"bugs": "https://github.com/kjanat/dr-downloader/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/dr-downloader.git"
	},
	"license": "MIT",
	"author": "Kaj Kowalski",
	"type": "module",
	"imports": {
		"#*": "./src/*.ts",
		"#pkg": "./package.json"
	},
	"bin": {
		"dr-downloader": "main.mjs"
	},
	"files": [
		"/main.mjs"
	],
	"scripts": {
		"build": "tsdown",
		"dr-downloader": "run start",
		"fake": "bun src/main.ts --test",
		"format": "dprint fmt",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"prepack": "run build",
		"start": "bun src/main.ts",
		"typecheck": "run -q typescript-7 --noEmit"
	},
	"dependencies": {
		"ansispeck": "^0.4.1",
		"dreamcli": "npm:@kjanat/dreamcli@^4.0.0-rc.1",
		"puppeteer": "^25"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@types/bun": "^1.3",
		"@types/node": "^26.2.0",
		"runner-run": "^0.25.1",
		"tsdown": "^0.22",
		"typescript": "npm:typescript@<7",
		"typescript-7": "npm:typescript@^7.0.2"
	},
	"packageManager": "bun@1.4.0",
	"volta": {
		"node": "26.7.0",
		"npm": "12.0.2"
	}
}
