{
	"name": "davinci-resolve-downloader",
	"version": "1.0.4",
	"description": "Download the free edition of DaVinci Resolve from Blackmagic Design",
	"keywords": [
		"davinci resolve",
		"download",
		"dreamcli"
	],
	"bugs": {
		"url": "https://github.com/kjanat/dr-downloader/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/dr-downloader.git"
	},
	"license": "MIT",
	"author": "Kaj Kowalski",
	"type": "module",
	"imports": {
		"#*": "./src/*.ts",
		"#pkg": "./package.json"
	},
	"bin": {
		"dr-downloader": "main.mjs"
	},
	"files": [
		"/main.mjs"
	],
	"scripts": {
		"build": "tsdown",
		"dr-downloader": "run start",
		"fake": "bun src/main.ts --test",
		"format": "dprint fmt",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"prepack": "run build",
		"start": "bun src/main.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@kjanat/dreamcli": "^2.5",
		"puppeteer": "^25"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5",
		"@types/bun": "^1.3",
		"@types/node": "^26",
		"runner-run": "^0.19",
		"tsdown": "^0.22",
		"typescript": "npm:typescript@>=6,<7",
		"typescript-7": "npm:typescript@^7"
	},
	"packageManager": "bun@1.3.14",
	"volta": {
		"node": "26.5.0",
		"npm": "12.0.0"
	}
}
